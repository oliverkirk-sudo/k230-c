  "native_footprint_load": {
    "command": [
      "/usr/bin/python3",
      "-c",
      "import pcbnew,json,sys\nfp=pcbnew.FootprintLoad(sys.argv[1],sys.argv[2])\nassert fp\npads=[]\nfor p in fp.Pads():\n pads.append({'number':p.GetNumber(),'xy_mm':[pcbnew.ToMM(p.GetPosition().x),pcbnew.ToMM(p.GetPosition().y)],'size_mm':[pcbnew.ToMM(p.GetSize().x),pcbnew.ToMM(p.GetSize().y)],'layers':list(p.GetLayerSet().Seq()),'mask_margin_mm':None if p.GetLocalSolderMaskMargin() is None else pcbnew.ToMM(p.GetLocalSolderMaskMargin())})\nassert len(pads)==4\nassert len([p for p in pads if pcbnew.F_Cu in p['layers']])==2\nassert all(p['number'] in ['1','2'] for p in pads if pcbnew.F_Cu in p['layers'])\nassert all(p['layers']==[pcbnew.F_Paste] for p in pads if not p['number'])\nprint(json.dumps({'kicad_version':pcbnew.GetBuildVersion(),'pads':pads}))",
      "<runtime>/project/cad/recovery-bulk22-candidates/CMK230_Bulk22_Candidates.pretty",
      "Samsung_CL31B226_1206_ReflowMid_SOURCE_CANDIDATE"
    ],
    "returncode": 0,
    "stdout": "{\"kicad_version\": \"9.0.2+dfsg-1\", \"pads\": [{\"number\": \"1\", \"xy_mm\": [-1.475, 0.0], \"size_mm\": [1.25, 1.8], \"layers\": [0, 1], \"mask_margin_mm\": 0.05}, {\"number\": \"\", \"xy_mm\": [-1.475, 0.0], \"size_mm\": [1.25, 1.8], \"layers\": [13], \"mask_margin_mm\": null}, {\"number\": \"2\", \"xy_mm\": [1.475, 0.0], \"size_mm\": [1.25, 1.8], \"layers\": [0, 1], \"mask_margin_mm\": 0.05}, {\"number\": \"\", \"xy_mm\": [1.475, 0.0], \"size_mm\": [1.25, 1.8], \"layers\": [13], \"mask_margin_mm\": null}]}\n",
    "stderr": ""
  },
